; Engine configuration file.
; It's best edited using the editor UI and not directly.
config_version=5

[application]

config/name="Sprout Guardians"
config/version="0.7.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/branding/app-icon.png"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="fractional"

[gui]

theme/custom_font="res://assets/ui/fonts/SproutUISans-Regular.otf"

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0

[debug]

settings/stdout/print_fps=false
file_logging/enable_file_logging=true
file_logging/max_log_files=5
file_logging/log_path="user://logs/godot.log"
